<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CampusKart | Register</title><link rel="stylesheet" href="css/style.css"></head><body class="auth"><div class="auth-shell wide"><div class="brand">Campus<span>Kart</span></div><p class="tagline">Create your campus account.</p><div class="auth-card"><h1>Create account</h1><p class="muted">Add your student details so buyers can contact you.</p><% if(request.getParameter("error")!=null){ %><div class="alert error"><%=request.getParameter("error")%></div><% } %><form action="register" method="post" onsubmit="return validateRegister()"><div class="grid two"><label>Full Name<input id="name" name="name" required maxlength="100"></label><label>Student ID / Roll No.<input name="studentId" required maxlength="30"></label><label>Email<input type="email" name="email" required maxlength="120"></label><label>Contact Number<input id="contact" name="contact" required maxlength="20"></label><label>Department<select name="department" required><option value="">Select</option><option>Computer Engineering</option><option>Information Technology</option><option>Electronics & Telecommunication</option><option>Mechanical Engineering</option><option>Civil Engineering</option><option>Other</option></select></label><label>Class / Year<select name="classYear" required><option value="">Select</option><option>FY</option><option>SY</option><option>TY</option><option>BE</option></select></label><label>Division<input name="division" required maxlength="10"></label><label>Password<input id="password" type="password" name="password" required minlength="6"></label><label>Confirm Password<input id="confirmPassword" type="password" required minlength="6"></label></div><button class="btn primary full">Create Account</button></form><p class="switch">Already have an account? <a href="login.jsp">Login</a></p></div></div><script src="js/script.js"></script></body></html>