<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %>
<% request.setCharacterEncoding("UTF-8"); response.setCharacterEncoding("UTF-8"); %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CampusKart | Marketplace</title><link rel="stylesheet" href="css/style.css"></head><body>
<header class="topbar"><a class="logo" href="marketplace">Campus<span>Kart</span></a><nav><a class="active" href="marketplace">Marketplace</a><a href="my-listings">My Listings</a><span class="user"><span class="avatar" aria-hidden="true">CK</span><%=session.getAttribute("userName")%></span><a class="btn small ghost" href="logout">Logout</a></nav></header>
<main class="container"><section class="hero"><div><p class="eyebrow">CAMPUS MARKETPLACE</p><h1>Find useful stuff from your campus.</h1><p class="muted">Browse student listings and meet sellers on campus to complete the purchase.</p></div><button class="btn primary" type="button" onclick="openModal('sellModal')">＋ Sell an Item</button></section>
<%if(request.getParameter("error")!=null){%><div class="alert error"><%=request.getParameter("error")%></div><%}%><%if(request.getParameter("success")!=null){%><div class="alert success"><%=request.getParameter("success")%></div><%}%>
<div class="category-bar"><a href="marketplace">All items</a><a href="marketplace?category=Books">Books</a><a href="marketplace?category=Electronics">Electronics</a><a href="marketplace?category=Stationery">Stationery</a><a href="marketplace?category=Engineering%20Equipment">Engineering Equipment</a><a href="marketplace?category=Bags%20%26%20Accessories">Bags &amp; Accessories</a><a href="marketplace?category=Other">Other</a></div>
<div class="product-grid"><% List<Map<String,Object>> products=(List<Map<String,Object>>)request.getAttribute("products"); if(products==null||products.isEmpty()){%><div class="empty"><h2>No items listed yet</h2><p class="muted">Be the first student to list something useful for campus life.</p><button class="btn primary" type="button" onclick="openModal('sellModal')">List your first item</button></div><%}else{for(Map<String,Object> p:products){%>
<article class="product-card" tabindex="0" role="button" aria-label="View details for <%=p.get("name")%>" onclick="openProduct(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openProduct(this)}" data-id="<%=p.get("id")%>" data-name="<%=p.get("name")%>" data-price="<%=p.get("price")%>" data-category="<%=p.get("category")%>" data-condition="<%=p.get("item_condition")%>" data-age="<%=p.get("item_age")%>" data-description="<%=p.get("description")%>" data-seller="<%=p.get("seller")%>" data-student="<%=p.get("student_id")%>" data-dept="<%=p.get("department")%>" data-class="<%=p.get("class_year")%>" data-division="<%=p.get("division")%>" data-contact="<%=p.get("contact")%>" data-email="<%=p.get("email")%>">
<div class="product-image"><img src="image?id=<%=p.get("id")%>" alt="<%=p.get("name")%>" loading="lazy"></div><div class="product-body"><span class="pill"><%=p.get("category")%></span><h3><%=p.get("name")%></h3><div class="price">&#8377;<%=p.get("price")%></div><p><%=p.get("item_condition")%> &#183; <%=p.get("item_age")%></p><button class="text-btn" type="button" onclick="event.stopPropagation();openProduct(this.closest('.product-card'))">View details &#8594;</button></div></article>
<%}}%></div></main>
<div id="productModal" class="modal" onclick="closeBackdrop(event,'productModal')"><div class="modal-card product-modal"><button class="close" type="button" aria-label="Close details" onclick="closeModal('productModal')">&#215;</button><div class="modal-image"><img id="modalImage" alt=""></div><div class="modal-content"><span id="modalCategory" class="pill"></span><h2 id="modalName"></h2><div id="modalPrice" class="price big"></div><p id="modalCondition"></p><p id="modalDescription" class="description"></p><hr><h3>Seller details</h3><p id="modalSeller" class="seller-name"></p><p id="modalAcademic"></p><p id="modalContact"></p><p id="modalEmail"></p><div class="note">Contact the seller and arrange to meet on campus to complete the purchase.</div></div></div></div>
<div id="sellModal" class="modal" onclick="closeBackdrop(event,'sellModal')"><div class="modal-card form-modal"><button class="close" type="button" aria-label="Close form" onclick="closeModal('sellModal')">&#215;</button><p class="eyebrow">SELL WITH CAMPUSKART</p><h2>List an item for fellow students</h2><p class="muted">Add clear details and a real photo so other students know what you are offering.</p><form action="add-product" method="post" enctype="multipart/form-data" onsubmit="return validateProduct()"><div class="grid two"><label>Product name<input name="name" required maxlength="120" placeholder="e.g. Engineering drawing kit"></label><label>Price (&#8377;)<input name="price" type="number" min="0.01" step="0.01" required placeholder="Enter your price"></label><label>Category<select name="category" required><option value="">Select category</option><option>Books</option><option>Electronics</option><option>Stationery</option><option>Engineering Equipment</option><option>Bags &amp; Accessories</option><option>Other</option></select></label><label>Condition<select name="condition" required><option>New</option><option>Like New</option><option>Good</option><option>Used</option></select></label><label>Age of item<input name="age" required maxlength="50" placeholder="e.g. 6 months"></label><label>Product photo<input id="productImage" type="file" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required></label></div><label>Description<textarea name="description" required maxlength="1000" rows="5" placeholder="Describe the item, its condition, and anything a buyer should know"></textarea></label><button class="btn primary full">Post item</button></form></div></div>
<script src="js/script.js"></script></body></html>