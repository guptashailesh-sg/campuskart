<%@ page import="java.util.*" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CampusKart | Marketplace</title><link rel="stylesheet" href="css/style.css"></head><body><header class="topbar"><a class="logo" href="marketplace">Campus<span>Kart</span></a><nav><a class="active" href="marketplace">Marketplace</a><a href="my-listings">My Listings</a><span class="user">👤 <%=session.getAttribute("userName")%></span><a class="btn small ghost" href="logout">Logout</a></nav></header><main class="container"><section class="hero"><div><p class="eyebrow">CAMPUS MARKETPLACE</p><h1>Find useful stuff from your campus.</h1><p class="muted">Browse student listings and meet sellers on campus to complete the purchase.</p></div><button class="btn primary" onclick="openModal('sellModal')">＋ Sell an Item</button></section><%if(request.getParameter("error")!=null){%><div class="alert error"><%=request.getParameter("error")%></div><%}%><%if(request.getParameter("success")!=null){%><div class="alert success"><%=request.getParameter("success")%></div><%}%><div class="category-bar"><a href="marketplace">All</a><a href="marketplace?category=Books">Books</a><a href="marketplace?category=Electronics">Electronics</a><a href="marketplace?category=Stationery">Stationery</a><a href="marketplace?category=Engineering%20Equipment">Engineering Equipment</a><a href="marketplace?category=Other">Other</a></div><div class="product-grid"><% List<Map<String,Object>> products=(List<Map<String,Object>>)request.getAttribute("products"); if(products==null||products.isEmpty()){%><div class="empty"><h2>No items here yet</h2><p>Be the first student to list something.</p></div><%}else{for(Map<String,Object> p:products){%><article class="product-card" onclick="openProduct(this)" data-id="<%=p.get("id")%>" data-name="<%=p.get("name")%>" data-price="<%=p.get("price")%>" data-category="<%=p.get("category")%>" data-condition="<%=p.get("item_condition")%>" data-age="<%=p.get("item_age")%>" data-description="<%=p.get("description")%>" data-seller="<%=p.get("seller")%>" data-student="<%=p.get("student_id")%>" data-dept="<%=p.get("department")%>" data-class="<%=p.get("class_year")%>" data-division="<%=p.get("division")%>" data-contact="<%=p.get("contact")%>" data-email="<%=p.get("email")%>"><div class="product-image"><img src="image?id=<%=p.get("id")%>" alt="Product"></div><div class="product-body"><span class="pill"><%=p.get("category")%></span><h3><%=p.get("name")%></h3><div class="price">₹<%=p.get("price")%></div><p><%=p.get("item_condition")%> · <%=p.get("item_age")%></p><button class="text-btn" type="button">View details →</button></div></article><%}}%></div></main><div id="productModal" class="modal" onclick="closeBackdrop(event,'productModal')"><div class="modal-card product-modal"><button class="close" onclick="closeModal('productModal')">×</button><div class="modal-image"><img id="modalImage"></div><div class="modal-content"><span id="modalCategory" class="pill"></span><h2 id="modalName"></h2><div id="modalPrice" class="price big"></div><p id="modalCondition"></p><p id="modalDescription" class="description"></p><hr><h3>Seller</h3><p id="modalSeller" class="seller-name"></p><p id="modalAcademic"></p><p id="modalContact"></p><p id="modalEmail"></p><div class="note">🤝 Contact the seller and meet on campus to complete the purchase.</div></div></div></div><div id="sellModal" class="modal" onclick="closeBackdrop(event,'sellModal')"><div class="modal-card form-modal"><button class="close" onclick="closeModal('sellModal')">×</button><h2>Sell an Item</h2><form action="add-product" method="post" enctype="multipart/form-data" onsubmit="return validateProduct()"><div class="grid two"><label>Product Name<input name="name" required maxlength="120"></label><label>Price (₹)<input name="price" type="number" min="0.01" step="0.01" required></label><label>Category<select name="category" required><option value="">Select</option><option>Books</option><option>Electronics</option><option>Stationery</option><option>Engineering Equipment</option><option>Bags & Accessories</option><option>Other</option></select></label><label>Condition<select name="condition" required><option>New</option><option>Like New</option><option>Good</option><option>Used</option></select></label><label>Age<input name="age" required maxlength="50" placeholder="e.g. 1 year"></label><label>Product Image<input id="productImage" type="file" name="image" accept="image/*" required></label></div><label>Description<textarea name="description" required maxlength="1000" rows="5"></textarea></label><button class="btn primary full">Post Item</button></form></div></div><script src="js/script.js"></script></body></html>