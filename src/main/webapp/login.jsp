<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CampusKart | Login</title><link rel="stylesheet" href="css/style.css"></head><body class="auth"><div class="auth-shell"><div class="brand">Campus<span>Kart</span></div><p class="tagline">Buy. Sell. Connect. Within Campus.</p><div class="auth-card"><h1>Welcome back</h1><p class="muted">Log in to your campus marketplace.</p><% if(request.getParameter("error")!=null){ %><div class="alert error"><%=request.getParameter("error")%></div><% } %><% if(request.getParameter("success")!=null){ %><div class="alert success"><%=request.getParameter("success")%></div><% } %><form action="login" method="post" onsubmit="return validateLogin()"><label>Student ID<input id="studentId" name="studentId" required></label><label>Password<input id="password" type="password" name="password" required></label><button class="btn primary full">Login</button></form><p class="switch">New here? <a href="register.jsp">Create an account</a></p></div></div><script src="js/script.js"></script></body></html>