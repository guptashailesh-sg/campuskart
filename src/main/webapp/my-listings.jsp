<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>CampusKart | My Listings</title><link rel="stylesheet" href="css/style.css"></head><body><header class="topbar"><a class="logo" href="marketplace">Campus<span>Kart</span></a><nav><a href="marketplace">Marketplace</a><a class="active" href="my-listings">My Listings</a><span class="user">👤 <%=session.getAttribute("userName")%></span><a class="btn small ghost" href="logout">Logout</a></nav></header><main class="container"><section class="page-title"><p class="eyebrow">SELLER AREA</p><h1>My Listings</h1><p class="muted">Manage the items you have posted.</p></section><%List<Map<String,Object>> products=(List<Map<String,Object>>)request.getAttribute("products"); if(products==null||products.isEmpty()){%><div class="empty"><h2>No listings yet</h2><p>Go to the marketplace and sell your first item.</p><a class="btn primary" href="marketplace">Browse Marketplace</a></div><%}else{%><div class="listing-list"><%for(Map<String,Object> p:products){%><div class="my-listing"><img src="image?id=<%=p.get("id")%>" alt="Product"><div class="listing-info"><span class="pill"><%=p.get("category")%></span><h3><%=p.get("name")%></h3><div class="price">₹<%=p.get("price")%></div><p><%=p.get("item_condition")%> · <%=p.get("item_age")%></p><p class="muted"><%=p.get("description")%></p></div><div class="listing-action"><%if("AVAILABLE".equals(p.get("status"))){%><span class="status available">● Available</span><form action="mark-sold" method="post" onsubmit="return confirm('Mark this item as sold?')"><input type="hidden" name="id" value="<%=p.get("id")%>"><button class="btn danger">Mark as Sold</button></form><%}else{%><span class="status sold">● Sold</span><small>Removed automatically after 48 hours.</small><%}%></div></div><%}%></div><%}%></main></body></html>